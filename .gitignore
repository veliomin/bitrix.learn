# ==============================================================================
# 1С-Битрикс Core & System Files (Исключаем ядро, так как оно на сервере)
# ==============================================================================
/bitrix/
/upload/

# Если папка bitrix нужна в репозитории, но без ядра (оставляем только кастомные настройки)
# Раскомментируйте строки ниже, если решите скачать /bitrix/ локально:
# /bitrix/*
# !/bitrix/.settings.php
# !/bitrix/php_interface/

# ==============================================================================
# Cache, Logs and Temporary Files
# ==============================================================================
# Кэш Битрикса внутри папки local
/local/cache/
/local/managed_cache/
/local/stack_cache/

# Логи и временные файлы
*.log
*.tmp
*.bak
/local/logs/

# ==============================================================================
# IDE configurations (Исключаем настройки PhpStorm)
# ==============================================================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==============================================================================
# OS generated files
# ==============================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================================================
# Front-end / Node.js (Если в local/templates используется сборка)
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ==============================================================================
# IDE Helpers / Autocomplete (Если вы создали файл-заглушку для констант)
# ==============================================================================
# Запрещаем отправлять локальный хелпер автодополнения в Git, если он лежит в local
/local/bitrix_ide_helper.php
/bitrix_ide_helper.php
# Системные файлы и конфигурации Битрикса, которые не нужно отслеживать в Git
.access.php
urlrewrite.php

# Настройки самого сервера (если на продакшене они другие)
.htaccess